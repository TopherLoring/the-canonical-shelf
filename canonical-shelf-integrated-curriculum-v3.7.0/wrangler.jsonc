{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-canonical-shelf",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
